{
  "name": "aetheris",
  "version": "1.0.0",
  "private": true,
  "description": "A procedural planet that changes forever without degenerating. The site itself has no dependencies; this file exists only for the test harness.",
  "scripts": {
    "verify": "node tools/verify.js",
    "serve": "node -e \"const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,s)=>{const r=q.url.split('?')[0].split('#')[0];const t=p.join(__dirname,r==='/'?'index.html':r);if(!f.existsSync(t)||f.statSync(t).isDirectory()){s.writeHead(404);return s.end()}s.writeHead(200,{'Content-Type':{'.html':'text/html','.jpg':'image/jpeg'}[p.extname(t)]||'application/octet-stream'});f.createReadStream(t).pipe(s)}).listen(8000,()=>console.log('http://localhost:8000/'))\""
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
