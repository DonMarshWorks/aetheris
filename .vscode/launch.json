{
  "version": "0.2.0",
  "configurations": [
    {
      // Serves the working tree and opens it. Deliberately no GPU or security
      // flags: the point is to see what a visitor sees before pushing, and a
      // flag that fixes something here would hide a real problem there.
      "name": "Aetheris (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8000/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "aetheris: serve"
    },
    {
      "name": "Aetheris (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8000/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "aetheris: serve"
    }
  ]
}
